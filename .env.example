# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DEL PROYECTO — Mezclador ESP32 v5
# ═══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env en la raíz del proyecto si necesitas variables
# Por ahora, todo está hardcoded en web_server.py y mezclador_v5.ino

# SERVIDOR WEB
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# ESP32 WiFi AP
ESP32_SSID=Mezclador-ESP32
ESP32_PASSWORD=mezclador123
ESP32_AP_IP=192.168.4.1
ESP32_WS_PORT=81

# LOGGING
LOG_LEVEL=INFO
